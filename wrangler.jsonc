{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "c4o",
	"compatibility_date": "2026-11-08",
	// Worker handles /api/*; Cloudflare serves the Vite build output for everything else.
	"main": "worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "c4o-intake",
			"database_id": "86be936c-0d61-4ff6-989a-bc336439fef4"
		}
	]
}